{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecBind task artifact v1",
  "description": "Runtime contract for the accepted tasks.yaml v1 plan and sparse execution-state shape.",
  "$defs": {
    "taskReference": {
      "type": "string",
      "description": "Unqualified positional Task ID resolved only within this tasks.yaml artifact.",
      "pattern": "^[1-9][0-9]*(?:\\.[1-9][0-9]*)?$"
    },
    "nonEmptyStringList": {
      "type": "array",
      "description": "Ordered non-empty string sequence; array order is preserved in the task-plan fingerprint.",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uniqueNonEmptyStringList": {
      "type": "array",
      "description": "Non-empty string set; values are sorted during task-plan fingerprint normalization.",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "completionCriteria": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "executableTask": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "requirement_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/taskReference"
        },
        "kind": {
          "const": "task"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "completion_criteria": {
          "$ref": "#/$defs/completionCriteria"
        },
        "requirement_ids": {
          "$ref": "#/$defs/uniqueNonEmptyStringList"
        },
        "boundaries": {
          "$ref": "#/$defs/uniqueNonEmptyStringList"
        },
        "contracts": {
          "$ref": "#/$defs/uniqueNonEmptyStringList"
        },
        "parallel": {
          "const": true
        },
        "depends_on": {
          "type": "array",
          "description": "Spec-local dependency set sorted during task-plan fingerprint normalization.",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/taskReference"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "parallel"
            ]
          },
          "then": {
            "required": [
              "boundaries"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "taskGroup": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "tasks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/taskReference"
        },
        "kind": {
          "const": "group"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/executableTask"
          }
        }
      },
      "additionalProperties": false
    },
    "planItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/taskGroup"
        },
        {
          "$ref": "#/$defs/executableTask"
        }
      ]
    },
    "taskPlan": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/planItem"
          }
        }
      },
      "additionalProperties": false
    },
    "completedTaskState": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "completed"
        }
      },
      "additionalProperties": false
    },
    "blockedTaskState": {
      "type": "object",
      "required": [
        "status",
        "blocked_reason"
      ],
      "properties": {
        "status": {
          "const": "blocked"
        },
        "blocked_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "taskExecutionState": {
      "oneOf": [
        {
          "$ref": "#/$defs/completedTaskState"
        },
        {
          "$ref": "#/$defs/blockedTaskState"
        }
      ]
    },
    "taskExecutionStates": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/taskReference"
      },
      "additionalProperties": {
        "$ref": "#/$defs/taskExecutionState"
      }
    },
    "taskExecution": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "tasks": {
          "$ref": "#/$defs/taskExecutionStates"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "plan"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan": {
      "$ref": "#/$defs/taskPlan"
    },
    "execution": {
      "$ref": "#/$defs/taskExecution"
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecBind spec metadata v1",
  "description": "Initial runtime-contract scaffold for spec.yaml. Add fields only after their schema decisions are accepted.",
  "$defs": {
    "passedAt": {
      "type": "string",
      "description": "RFC 3339 date-time with an explicit UTC or numeric-offset timezone.",
      "format": "date-time",
      "pattern": "(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "implementationRevision": {
      "type": "string",
      "description": "Full lowercase Git commit object ID; semantic validation requires the form used by the current project repository.",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "mechanicalCheck": {
      "type": "object",
      "required": [
        "kind",
        "command",
        "exit_code"
      ],
      "properties": {
        "kind": {
          "enum": [
            "test",
            "build",
            "smoke",
            "lint",
            "typecheck",
            "custom"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "mechanicalCheckList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mechanicalCheck"
      }
    },
    "completionGateEvidence": {
      "type": "object",
      "required": [
        "passed_at",
        "implementation_revision",
        "mechanical_checks"
      ],
      "properties": {
        "passed_at": {
          "$ref": "#/$defs/passedAt"
        },
        "implementation_revision": {
          "$ref": "#/$defs/implementationRevision"
        },
        "mechanical_checks": {
          "$ref": "#/$defs/mechanicalCheckList"
        }
      },
      "additionalProperties": false
    },
    "requirementIdList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requirementsGateEvidence": {
      "type": "object",
      "required": [
        "passed_at",
        "approval_mode",
        "approved_requirement_ids",
        "input_revisions"
      ],
      "properties": {
        "passed_at": {
          "$ref": "#/$defs/passedAt"
        },
        "approval_mode": {
          "enum": [
            "explicit",
            "delegated"
          ]
        },
        "delegation_workflow": {
          "type": "string",
          "minLength": 1
        },
        "approved_requirement_ids": {
          "$ref": "#/$defs/requirementIdList"
        },
        "input_revisions": {
          "type": "object",
          "required": [
            "requirements.md"
          ],
          "properties": {
            "requirements.md": {
              "$ref": "#/$defs/fingerprint"
            }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        {
          "properties": {
            "approval_mode": {
              "const": "explicit"
            }
          },
          "not": {
            "required": [
              "delegation_workflow"
            ]
          }
        },
        {
          "properties": {
            "approval_mode": {
              "const": "delegated"
            }
          },
          "required": [
            "delegation_workflow"
          ]
        }
      ],
      "additionalProperties": false
    },
    "designGateEvidence": {
      "type": "object",
      "required": [
        "passed_at",
        "approval_mode",
        "input_revisions"
      ],
      "properties": {
        "passed_at": {
          "$ref": "#/$defs/passedAt"
        },
        "approval_mode": {
          "enum": [
            "explicit",
            "delegated"
          ]
        },
        "delegation_workflow": {
          "type": "string",
          "minLength": 1
        },
        "input_revisions": {
          "type": "object",
          "required": [
            "design.md",
            "contract.md"
          ],
          "properties": {
            "design.md": {
              "$ref": "#/$defs/fingerprint"
            },
            "contract.md": {
              "$ref": "#/$defs/fingerprint"
            }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        {
          "properties": {
            "approval_mode": {
              "const": "explicit"
            }
          },
          "not": {
            "required": [
              "delegation_workflow"
            ]
          }
        },
        {
          "properties": {
            "approval_mode": {
              "const": "delegated"
            }
          },
          "required": [
            "delegation_workflow"
          ]
        }
      ],
      "additionalProperties": false
    },
    "tasksGateEvidence": {
      "type": "object",
      "required": [
        "passed_at",
        "approval_mode",
        "input_revisions"
      ],
      "properties": {
        "passed_at": {
          "$ref": "#/$defs/passedAt"
        },
        "approval_mode": {
          "enum": [
            "explicit",
            "delegated"
          ]
        },
        "delegation_workflow": {
          "type": "string",
          "minLength": 1
        },
        "input_revisions": {
          "type": "object",
          "required": [
            "tasks.yaml#plan"
          ],
          "properties": {
            "tasks.yaml#plan": {
              "$ref": "#/$defs/fingerprint"
            }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        {
          "properties": {
            "approval_mode": {
              "const": "explicit"
            }
          },
          "not": {
            "required": [
              "delegation_workflow"
            ]
          }
        },
        {
          "properties": {
            "approval_mode": {
              "const": "delegated"
            }
          },
          "required": [
            "delegation_workflow"
          ]
        }
      ],
      "additionalProperties": false
    },
    "gateEvidence": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "requirements": {
          "$ref": "#/$defs/requirementsGateEvidence"
        },
        "design": {
          "$ref": "#/$defs/designGateEvidence"
        },
        "tasks": {
          "$ref": "#/$defs/tasksGateEvidence"
        },
        "completion": {
          "$ref": "#/$defs/completionGateEvidence"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    }
  },
  "additionalProperties": false
}

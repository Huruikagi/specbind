{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskRevision",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0,
      "const": 1
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plan": {
      "$ref": "#/$defs/TaskPlan"
    },
    "progress": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Disposition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceFingerprint",
    "plan",
    "progress"
  ],
  "$defs": {
    "TaskPlan": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanItem"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "items"
      ]
    },
    "PlanItem": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskGroup"
        },
        {
          "$ref": "#/$defs/ExecutableTask"
        }
      ]
    },
    "TaskGroup": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/TaskReference"
        },
        "kind": {
          "$ref": "#/$defs/GroupKind"
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExecutableTask"
          },
          "minItems": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "tasks"
      ]
    },
    "TaskReference": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:\\.[1-9][0-9]*)?$"
    },
    "GroupKind": {
      "type": "string",
      "enum": [
        "group"
      ]
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "ExecutableTask": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/TaskReference"
        },
        "kind": {
          "$ref": "#/$defs/TaskKind"
        },
        "title": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "details": {
          "$ref": "#/$defs/NonEmptyStringList"
        },
        "completion_criteria": {
          "$ref": "#/$defs/NonEmptyStringList"
        },
        "requirement_ids": {
          "$ref": "#/$defs/UniqueNonEmptyStringList"
        },
        "boundaries": {
          "$ref": "#/$defs/UniqueNonEmptyStringList"
        },
        "contracts": {
          "$ref": "#/$defs/UniqueNonEmptyStringList"
        },
        "depends_on": {
          "$ref": "#/$defs/TaskReferenceList"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "requirement_ids"
      ]
    },
    "TaskKind": {
      "type": "string",
      "enum": [
        "task"
      ]
    },
    "NonEmptyStringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "UniqueNonEmptyStringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "TaskReferenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskReference"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "Disposition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "preserve"
            },
            "from": {
              "$ref": "#/$defs/TaskReference"
            },
            "to": {
              "$ref": "#/$defs/TaskReference"
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "from",
            "to",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "reset"
            },
            "from": {
              "$ref": "#/$defs/TaskReference"
            },
            "to": {
              "$ref": "#/$defs/TaskReference"
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "from",
            "to",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "remove"
            },
            "from": {
              "$ref": "#/$defs/TaskReference"
            },
            "reason": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "from",
            "reason"
          ]
        }
      ]
    }
  }
}

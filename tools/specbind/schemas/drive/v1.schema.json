{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecBind Drive defaults v1",
  "description": "Project-owned Drive defaults inside `.specbind.json` schemaVersion 1.",
  "type": "object",
  "properties": {
    "replan": {
      "type": "boolean"
    },
    "recovery": {
      "$ref": "#/$defs/RecoveryMode"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "RecoveryMode": {
      "type": "string",
      "enum": [
        "bounded",
        "progress"
      ]
    }
  }
}

# Disabled while SpecBind establishes its own package and release policy.
# Rename this file back to publish.yml only after the package identity,
# npm ownership, versioning, and release process have been reviewed.

name: Publish Package

on:
  push:
    tags:
      - 'v*.*.*'
  workflow_dispatch:

permissions:
  id-token: write
  contents: read

jobs:
  publish:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          registry-url: 'https://registry.npmjs.org'

      - name: Update npm
        run: npm install -g npm@latest

      - name: Install
        working-directory: tools/specbind
        run: npm ci

      - name: Build
        working-directory: tools/specbind
        run: npm run build --if-present

      - name: Test
        working-directory: tools/specbind
        run: npm test --if-present

      - name: Publish
        working-directory: tools/specbind
        run: npm publish
